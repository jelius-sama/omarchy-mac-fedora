#!/bin/bash

socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock | \
while IFS= read -r line; do
    if [[ "$line" == "urgent>>"* ]]; then
        addr="${line#urgent>>}"
        # Get window info from the address
        class=$(hyprctl clients -j | jq -r ".[] | select(.address == \"0x$addr\") | .class")
        title=$(hyprctl clients -j | jq -r ".[] | select(.address == \"0x$addr\") | .title")
        notify-send "🔔 $class" "$title is requesting attention"
    fi
done
